datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  String    @id @default(uuid())
  name                String    @default("Learner")
  email               String?   @unique
  password            String?
  timezone            String    @default("UTC")
  onboardingCompleted Boolean   @default(true)
  focusPreference     String?   @default("personal")
  routinesJson        String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  goals               Goal[]
  behavior            Behavior?
  messages            ChatMessage[]
}

model Goal {
  id           String      @id @default(uuid())
  userId       String
  title        String
  description  String?
  deadline     DateTime
  progress     Float       @default(0.0) // 0 to 100
  startDate    DateTime    @default(now())
  endDate      DateTime
  durationDays Int         @default(60)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones   Milestone[]
}

model Milestone {
  id          String   @id @default(uuid())
  goalId      String
  title       String
  order       Int      @default(1)
  dueDate     DateTime
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  goal        Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  tasks       Task[]
}

model Task {
  id                    String         @id @default(uuid())
  milestoneId           String
  title                 String
  description           String?
  scheduledTime         DateTime
  estimatedMinutes      Int            @default(45)
  priority              String         @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  reminderInterval      Int            @default(15) // minutes
  completed             Boolean        @default(false)
  completedAt           DateTime?
  verificationType      String         @default("LEARNING") // LEARNING, CODING, READING, WORKOUT, GENERAL
  topic                 String?
  sourceContext         String?
  order                 Int            @default(1)
  snoozedUntil          DateTime?
  activeEscalationLevel Int            @default(1)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  milestone             Milestone      @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  reminders             Reminder[]
  verifications         Verification[]
  chatMessages          ChatMessage[]
}

model Reminder {
  id              String   @id @default(uuid())
  taskId          String
  sentAt          DateTime @default(now())
  escalationLevel Int      @default(1) // 1: Friendly, 2: Firm, 3: Strict, 4: Emergency
  message         String
  channel         String   @default("BROWSER") // BROWSER, SOUND, CONSOLE, WHATSAPP, TELEGRAM, EMAIL
  acknowledged    Boolean  @default(false)
  snoozedUntil    DateTime?
  createdAt       DateTime @default(now())

  task            Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String    @id @default(uuid())
  taskId     String
  question   String
  answer     String?
  feedback   String?
  passed     Boolean   @default(false)
  score      Float?
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  task       Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Behavior {
  id                 String   @id @default(uuid())
  userId             String   @unique
  preferredStudyTime String   @default("20:00") // e.g. "20:00"
  skippedCount       Int      @default(0)
  streak             Int      @default(5)
  bestStreak         Int      @default(12)
  completionRate     Float    @default(0.85)
  lastActiveDate     DateTime?
  insightsJson       String   @default("[]") // serialized JSON array of BehaviorInsight
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id             String   @id @default(uuid())
  userId         String
  sender         String   // "mentor" | "user" | "system"
  text           String
  taskId         String?
  actionRequired String?  // "VERIFY" | "SNOOZE" | "ACKNOWLEDGE" | "NONE"
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task           Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
}
