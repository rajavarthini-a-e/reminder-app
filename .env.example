# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (SQLite)
DATABASE_URL="file:./dev.db"

# AI Configuration (OpenAI-compatible API layer)
# Set your OpenAI API key or any compatible provider (Groq, OpenRouter, Ollama, DeepSeek)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# When OPENAI_API_KEY is empty, MentorAI operates in smart local heuristic mode,
# so the system is 100% operational immediately out-of-the-box!

# Notification Settings
ENABLE_BROWSER_NOTIFICATIONS=true
ENABLE_SOUND_ALERTS=true
# Optional Webhook for Telegram/Discord/Slack/WhatsApp forwarder
NOTIFICATION_WEBHOOK_URL=
